@@ -0,0 +1,47 @@
+//! Termux Jobs measurement extension. Optional, observational, no output content stored.
+use sha2::{Digest, Sha256};
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::sync::Mutex;
+static OUTPUT: Mutex<Option<std::fs::File>> = Mutex::new(None);
+pub fn record(input: &str, output: &str) {
+    let Some(path) = std::env::var_os("JOBS_RTK_BYTES_FILE") else { return; };
+    if input.contains('\u{fffd}') || output.contains('\u{fffd}') { return; }
+    if let Ok(owner) = std::env::var("JOBS_RTK_BYTES_PID") {
+        if owner.parse::<u32>().ok() != Some(std::process::id()) { return; }
+    }
+    // All normalized outputs are prefixes; reuse the SHA state instead of hashing
+    // a large output three times. The resulting digests are ordinary SHA-256.
+    let whitespace = output.trim_end();
+    let newline = output.trim_end_matches(['\r', '\n']);
+    let mut hash = Sha256::new();
+    hash.update(whitespace.as_bytes());
+    let whitespace_hash = format!("{:x}", hash.clone().finalize());
+    hash.update(&output.as_bytes()[whitespace.len()..newline.len()]);
+    let newline_hash = format!("{:x}", hash.clone().finalize());
+    hash.update(&output.as_bytes()[newline.len()..]);
+    let output_hash = format!("{:x}", hash.finalize());
+    let normalizations = vec![
+        serde_json::json!({"hash":newline_hash,"inputBytes":input.trim_end_matches(['\r','\n']).len()}),
+        serde_json::json!({"hash":whitespace_hash,"inputBytes":input.trim_end().len()})
+    ];
+    let value=serde_json::json!({"version":1,"inputBytes":input.len(),"outputBytes":output.len(),"outputHash":output_hash,"normalizations":normalizations});
+    // Hold the original descriptor: repeated captures invalidate the first event
+    // without opening a path again. PRoot may resolve symlinks before O_NOFOLLOW.
+    let Ok(mut slot) = OUTPUT.lock() else { return; };
+    if let Some(file) = slot.as_mut() {
+        let _ = file.write_all(b"\n{}");
+        return;
+    }
+    if std::fs::symlink_metadata(&path).is_ok() { return; }
+    if let Ok(mut file) = std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(path) {
+        let _ = file.write_all(format!("{}\n",value).as_bytes());
+        *slot = Some(file);
+    }
+}
+
+/// Join only when measurement is enabled, so the off path does not copy buffers.
+pub fn record_parts(input: &[&str], output: &[&str]) {
+    if std::env::var_os("JOBS_RTK_BYTES_FILE").is_none() { return; }
+    record(&input.concat(), &output.concat());
+}
